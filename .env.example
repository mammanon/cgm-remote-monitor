# Copy this file to ".env" and change the values.

# The password used to add and edit meals (minimum 12 characters). Required.
API_SECRET=change-me-please-now

# A short code (8+ characters) you give the doctor so they can write
# comments. It cannot change or delete meals. Leave empty to turn the
# doctor's comment box off.
DOCTOR_CODE=

# Sugar units shown in the app: mg/dl or mmol
DISPLAY_UNITS=mg/dl

# Only needed for automatic HTTPS (docker compose --profile https):
# a domain name that points to this server.
#DOMAIN=nightscout.example.com
